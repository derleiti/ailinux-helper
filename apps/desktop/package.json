{
  "name": "@ailinux/helper-desktop",
  "version": "2.90.34",
  "private": true,
  "description": "AILinux Helper cross-platform device companion for Linux, Windows and macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --test test/*.test.js",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "test": "npm run check"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "AILinux Helper",
  "build": {
    "appId": "me.ailinux.helper.desktop",
    "productName": "AILinux Helper",
    "artifactName": "AILinux-Helper-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "shell_backends.js",
      "docker_runtime.js",
      "service_runtime.js",
      "portable_runtime.js",
      "live_vision.js",
      "capture.html",
      "package.json",
      "design-tokens.json",
      "bug_reporter.js",
      "bug_report_preload.js",
      "bug_report.html"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "../../assets/desktop"
    },
    "protocols": [
      {
        "name": "AILinux Helper",
        "schemes": [
          "ailinux-helper",
          "ailinux-workspace"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "synopsis": "AILinux cross-platform local device helper",
      "maintainer": "AILinux <admin@ailinux.me>",
      "icon": "../../assets/desktop/icon.png",
      "syncDesktopName": true
    },
    "deb": {
      "priority": "optional"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "../../assets/desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "../../assets/desktop/icon-macos-1024.png"
    },
    "extraResources": [
      {
        "from": "../../assets/desktop/icon.png",
        "to": "icon.png"
      },
      {
        "from": "linux_portal_input.py",
        "to": "linux_portal_input.py"
      }
    ],
    "executableName": "ailinux-helper"
  },
  "author": {
    "name": "AILinux",
    "email": "admin@ailinux.me"
  },
  "homepage": "https://ailinux.me",
  "repository": {
    "type": "git",
    "url": "https://github.com/derleiti/ailinux-helper.git"
  },
  "desktopName": "ailinux-helper.desktop"
}
